MONGO_URI=
MONGO_DB=final2026

# ----------------------------
# Kafka (Confluent)
# ----------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_ITEMS=items.events
KAFKA_CONSUMER_GROUP=items-worker
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1

